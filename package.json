{
  "name": "planner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "build": "vite build",
    "start:server": "node server/index.mjs",
    "preview": "vite preview",
    "images:optimize": "node scripts/optimize-assets.mjs",
    "mobile:build": "vite build --mode mobile",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:copy": "npm run mobile:build && cap copy",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:run:android": "npm run mobile:build && cap sync android && cap run android",
    "mobile:run:ios": "npm run mobile:build && cap sync ios && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.7.0",
    "highcharts": "^12.4.0",
    "highcharts-react-official": "^3.2.3",
    "jose": "^6.2.0",
    "multer": "^1.4.5-lts.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "stripe": "^16.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.34.5",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  }
}
