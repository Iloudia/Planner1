rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasAdminClaim() {
      return isSignedIn() &&
        (request.auth.token.admin == true || request.auth.token.role == "admin");
    }

    function hasAdminEmail() {
      return isSignedIn() &&
        (request.auth.token.email == "contact@meandrituals.com" ||
          request.auth.token.email == "iloudiav@gmail.com");
    }

    function hasAdminDocument() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function isAdmin() {
      return hasAdminClaim() || hasAdminEmail() || hasAdminDocument();
    }

    function hasPremiumAccess() {
      return isAdmin() ||
        (isSignedIn() &&
          (request.auth.token.premium == true || request.auth.token.plan == "premium")) ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/premiumSubscriptions/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/premiumSubscriptions/$(request.auth.uid)).data.status in ["active", "trialing"]);
    }

    function isPlannerCollection(collectionName) {
      return collectionName == "journalEntries" ||
        collectionName == "financeEntries" ||
        collectionName == "financeMonthlySnapshots" ||
        collectionName == "wishlistCategories" ||
        collectionName == "wishlistItems" ||
        collectionName == "sportDashboard" ||
        collectionName == "sportWeeklyBoards" ||
        collectionName == "workoutExercises" ||
        collectionName == "workoutSeries" ||
        collectionName == "workoutVideos" ||
        collectionName == "workoutSettings" ||
        collectionName == "selfLoveDraft" ||
        collectionName == "selfLovePhotos" ||
        collectionName == "bodyGoalPhotos" ||
        collectionName == "selfLoveQualities" ||
        collectionName == "selfLoveThoughts" ||
        collectionName == "selfLoveArchiveEntries" ||
        collectionName == "routineItems" ||
        collectionName == "routineDailyProgress" ||
        collectionName == "goalsDailyTrackers" ||
        collectionName == "dietWeeklyPlans" ||
        collectionName == "dietCustomRecipes" ||
        collectionName == "dietPreferences";
    }

    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);

      match /calendarEvents/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          (!request.resource.data.keys().hasAny(["recurrence"]) || hasPremiumAccess());
        allow update: if isOwner(userId) &&
          (!request.resource.data.keys().hasAny(["recurrence"]) ||
            resource.data.keys().hasAny(["recurrence"]) ||
            hasPremiumAccess());
        allow delete: if isOwner(userId);
      }

      match /{collectionName}/{docId} {
        allow read, write: if isOwner(userId) && isPlannerCollection(collectionName);
      }
    }

    match /premiumSubscriptions/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    match /blogArticles/{articleId} {
      allow get: if isAdmin() || resource.data.status == "published";
      allow list: if isAdmin() || resource.data.status == "published";
      allow create, update: if isAdmin() &&
        request.resource.data.href is string &&
        request.resource.data.title is string &&
        request.resource.data.content is string &&
        request.resource.data.status in ["draft", "published"];
      allow delete: if isAdmin();
    }
  }
}
